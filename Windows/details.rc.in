#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @RC_VERSION_COMMA@
 PRODUCTVERSION @RC_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // Language + codepage (US English)
        BEGIN
            VALUE "CompanyName", "@RC_COMPANY@\0"
            VALUE "FileDescription", "@RC_DESCRIPTION@\0"
            VALUE "FileVersion", "@RC_PRODUCT_VERSION_STR@\0"
            VALUE "InternalName", "@RC_INTERNAL_NAME@\0"
            VALUE "OriginalFilename", "@RC_ORIGINAL_FILENAME@\0"
            VALUE "ProductName", "@RC_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@RC_PRODUCT_VERSION_STR@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END